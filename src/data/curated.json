    { "id": "en-paternal", "label": "paternal", "latin": null, "lang": "en", "langLabel": "English", "gloss": "of or like a father", "notes": "Not inherited but borrowed: from Latin 'paternus' (← 'pater'), from PIE *ph₂tḗr. So English has two reflexes of this root — inherited 'father' and learned 'paternal'." },

    { "id": "pie-mater", "label": "*méh₂tēr", "latin": null, "lang": "pie", "langLabel": "Proto-Indo-European", "gloss": "mother", "notes": "PIE word for 'mother', likely from a nursery syllable 'mā' plus the kinship suffix seen in *ph₂tḗr 'father'. Reflected across nearly every branch of the family." },
