{
  "nodes": [
    { "id": "pie-dhwer", "label": "*dʰwer-", "latin": null, "lang": "pie", "langLabel": "Proto-Indo-European", "gloss": "door, gate, doorway", "notes": "Reconstructed PIE root for 'door/gate', often appearing in the plural (a doorway was originally a pair of doors). Ancestor of Germanic 'door/Tür', Iranian 'dar', Greek 'thúrā', Latin 'forēs' and Slavic 'dver'. Reconstruction notation varies (e.g. *dʰwer-, *dhwer-)." },
    { "id": "pgmc-duro", "label": "*durō", "latin": null, "lang": "pgmc", "langLabel": "Proto-Germanic", "gloss": "door" },
    { "id": "ang-duru", "label": "duru", "latin": null, "lang": "ang", "langLabel": "Old English", "gloss": "door" },
    { "id": "en-door", "label": "door", "latin": null, "lang": "en", "langLabel": "English", "gloss": "a hinged or sliding barrier closing an entrance", "notes": "From Old English 'duru' (door) and 'dor' (gate), from Proto-Germanic *durō, ultimately from PIE *dʰwer-. Cognate with German 'Tür' and, more distantly, Persian 'dar' (در), Greek 'thúrā' and Russian 'dver'." },
    { "id": "goh-turi", "label": "turi", "latin": null, "lang": "goh", "langLabel": "Old High German", "gloss": "door" },
    { "id": "de-tuer", "label": "Tür", "latin": null, "lang": "de", "langLabel": "German", "gloss": "door", "notes": "From Old High German 'turi', from Proto-Germanic *durō, from PIE *dʰwer-. Directly cognate with English 'door'." },
    { "id": "pira-dwar", "label": "*dwar-", "latin": null, "lang": "pira", "langLabel": "Proto-Iranian", "gloss": "door, gate" },
    { "id": "peo-duvara", "label": "𐎯𐎺𐎼𐎹𐎠", "latin": "duvarayā", "lang": "peo", "langLabel": "Old Persian", "gloss": "door, gate, portal", "notes": "Old Persian, written in Old Persian cuneiform." },
    { "id": "pal-dar", "label": "𐭡𐭡𐭠", "latin": "dar", "lang": "pal", "langLabel": "Middle Persian", "gloss": "gate, court, palace", "notes": "Middle Persian, written in Pahlavi script." },
    { "id": "fa-dar", "label": "در", "latin": "dar", "lang": "fa", "langLabel": "Persian", "gloss": "door, gate", "notes": "From Middle Persian 'dar' (𐭡𐭡𐭠), from Old Persian 'duvara-' (𐎯𐎺𐎼𐎹𐎠), from Proto-Iranian *dwar-, from PIE *dʰwer- — the same root as English 'door' and German 'Tür'." },
    { "id": "la-fores", "label": "forēs", "latin": null, "lang": "la", "langLabel": "Latin", "gloss": "door, double door" },
    { "id": "grc-thura", "label": "θύρα", "latin": "thúrā", "lang": "grc", "langLabel": "Ancient Greek", "gloss": "door" },
    { "id": "el-thura", "label": "θύρα", "latin": "thýra", "lang": "el", "langLabel": "Modern Greek", "gloss": "door, gate (formal)", "notes": "Inherited from Ancient Greek θύρα, from PIE *dʰwer-." },
    { "id": "sa-dvar", "label": "द्वार", "latin": "dvāra", "lang": "sa", "langLabel": "Sanskrit", "gloss": "door, gate" },
    { "id": "hi-dvar", "label": "द्वार", "latin": "dvār", "lang": "hi", "langLabel": "Hindi", "gloss": "door, gate", "notes": "From Sanskrit द्वार (dvāra), from PIE *dʰwer- — cognate with English 'door'." },
    { "id": "psl-dviri", "label": "*dvьrь", "latin": null, "lang": "psl", "langLabel": "Proto-Slavic", "gloss": "door" },
    { "id": "ru-dver", "label": "дверь", "latin": "dver'", "lang": "ru", "langLabel": "Russian", "gloss": "door", "notes": "From Proto-Slavic *dvьrь, from PIE *dʰwer- — cognate with English 'door' and Persian 'dar'." },

    { "id": "pie-phter", "label": "*ph₂tḗr", "latin": null, "lang": "pie", "langLabel": "Proto-Indo-European", "gloss": "father", "notes": "PIE term for 'father', the source of Latin 'pater', Greek 'patḗr', Sanskrit 'pitṛ́', alongside the Germanic and Iranian forms here." },
